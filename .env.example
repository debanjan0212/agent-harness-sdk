# Model (leave empty to use the offline ScriptedModel / playbook brain)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Telemetry: any OTLP/HTTP endpoint (Grafana Alloy, OTel Collector, Datadog Agent, Honeycomb...)
# e.g. http://localhost:4318 while deploy/docker-compose.yaml is running; empty = console only
OTEL_EXPORTER_OTLP_ENDPOINT=
# only if your vendor needs a key, e.g. x-honeycomb-team=<key>
OTEL_EXPORTER_OTLP_HEADERS=
DEPLOYMENT_ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=text

# Harness.io (REST tool pack and the official MCP server read the same names)
HARNESS_API_KEY=
HARNESS_DEFAULT_ORG_ID=default
HARNESS_DEFAULT_PROJECT_ID=
HARNESS_ROLLBACK_PIPELINE=rollback

# Observability packs
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
NOTIFY_WEBHOOK_URL=

# Incident Commander
IC_SOURCE=fixture
IC_SCENARIO=bad-deploy
IC_DB=incidents.db
